<Window x:Class="Sketch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vp="clr-namespace:Sketch.App.Viewport"
        Title="Untitled - Sketch" Height="900" Width="1500" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="#F3F4F6" FontFamily="Segoe UI" FontSize="12"
        Focusable="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" Background="#F7F7F8" Padding="2,1" />

        <Border DockPanel.Dock="Top" Background="#F7F7F8" BorderBrush="#D9DCE1" BorderThickness="0,1,0,1">
            <DockPanel Margin="4,2">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,4,0">
                    <TextBlock x:Name="MeasurementsLabel" Text="Measurements" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#555B66" MinWidth="58" />
                    <TextBox x:Name="MeasurementsBox" Width="140" Height="24" VerticalContentAlignment="Center" Margin="0,0,14,0"
                             ToolTip="Measurements: while drawing, type a value and press Enter." />
                    <TextBlock Text="Tag:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#555B66" />
                    <ComboBox x:Name="TagCombo" Width="180" Height="24" ToolTip="Tag of the selected entities; with no selection, the tag for new geometry" />
                </StackPanel>
                <WrapPanel x:Name="TopToolbar" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="#EEF0F3" BorderBrush="#D9DCE1" BorderThickness="0,0,0,1">
            <ContentControl x:Name="ScenesHost" Margin="2,3,2,0" />
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#EEF0F3" BorderBrush="#D9DCE1" BorderThickness="0,1,0,0">
            <Grid Margin="8,4">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#30343B" />
                <!-- Invisible keyboard-focus holder so shortcuts never end up in a text box. -->
                <Border x:Name="FocusSink" Focusable="True" Width="0" Height="0" HorizontalAlignment="Left" FocusVisualStyle="{x:Null}" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Left" Background="#F7F7F8" BorderBrush="#D9DCE1" BorderThickness="0,0,1,0">
            <WrapPanel x:Name="LeftToolbar" Orientation="Horizontal" Width="70" Margin="2,4" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="5" />
                <ColumnDefinition x:Name="TrayColumn" Width="330" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#C9CDD3" BorderThickness="1">
                <Grid>
                    <vp:GlViewport x:Name="Viewport" />
                    <Popup x:Name="CursorTip" Placement="Relative" PlacementTarget="{Binding ElementName=Viewport}"
                           AllowsTransparency="True" IsHitTestVisible="False" Focusable="False">
                        <Border Background="#FFFFF4D6" BorderBrush="#B8A86A" BorderThickness="1" Padding="5,1" CornerRadius="2">
                            <TextBlock x:Name="CursorTipText" FontSize="11" Foreground="#333" />
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#E3E5E9" />

            <Border Grid.Column="2" Background="#FAFAFB" BorderBrush="#D9DCE1" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#EDEEF1" BorderBrush="#D9DCE1" BorderThickness="0,0,0,1">
                        <TextBlock Text="Default Tray" FontWeight="SemiBold" Margin="8,5,8,5" Foreground="#30343B" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="Tray" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
